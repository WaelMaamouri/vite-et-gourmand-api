###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_APP_SECRET
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://example.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Inject real DATABASE_URL via environment variables (Render/dashboard), never commit secrets here.
DATABASE_URL="mysql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/defaultdb?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Brevo : secret uniquement dans .env.local (local) ou variable Render — jamais dans .env si le dépôt est public.
BREVO_SMTP_KEY=
BREVO_API_KEY=
MAILER_DSN="smtp://a296d2001%40smtp-brevo.com:${BREVO_SMTP_KEY}@smtp-relay.brevo.com:2525?encryption=tls&auth_mode=login&timeout=5"
MAILER_FROM_EMAIL=vitegourmand00@gmail.com
###< symfony/mailer ###

# URL publique du front (sans slash final) — utilisée dans le lien de réinitialisation
FRONT_APP_URL=https://front-vite-et-gourmand.vercel.app

###> doctrine/mongodb-odm-bundle ###
MONGODB_URI="mongodb+srv://maamouriwael_db_user:CHANGE_ME_MONGO_PASSWORD@cluster0.rhr3xhn.mongodb.net/vite_gourmand_nosql?retryWrites=true&w=majority&appName=Cluster0"
